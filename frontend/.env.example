# Leave this unset to use the default relative '/api' path, which works
# both with the Vite dev-server proxy (npm run dev) and the combined
# single-port setup where Express serves the built frontend.
# Only set this if pointing the frontend at a backend on a different host,
# e.g. a deployed Render URL: VITE_API_URL=https://foodshare-api.onrender.com/api
# VITE_API_URL=
