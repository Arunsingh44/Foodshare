# Server
NODE_ENV=development
PORT=5000
# If running the combined single-port setup (npm start from repo root),
# set this to the same URL the app is served at, e.g. http://localhost:5000.
# If running frontend/backend as separate dev servers, use the frontend's
# own port, e.g. http://localhost:5173.
CLIENT_URL=http://localhost:5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodshareplus?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7
REFRESH_TOKEN_SECRET=replace_with_another_long_random_string
REFRESH_TOKEN_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
